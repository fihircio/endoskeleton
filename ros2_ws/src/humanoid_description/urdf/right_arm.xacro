<?xml version="1.0"?>
<!-- Right arm 6-DOF, mirror of left (spec section 8). Only right_elbow_pitch PHYSICAL. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="right_arm_chain">
    <link name="right_shoulder_pitch_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.055"/></geometry>
        <material name="joint_dark"/>
      </visual>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="right_shoulder_pitch" type="revolute">
      <parent link="torso_link"/>
      <child link="right_shoulder_pitch_link"/>
      <origin xyz="0 -0.20 0.30" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.60" upper="2.60" effort="10" velocity="2.0"/>
    </joint>

    <link name="right_shoulder_roll_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.045"/></geometry>
        <material name="joint_dark"/>
      </visual>
      <inertial>
        <mass value="0.25"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="right_shoulder_roll" type="revolute">
      <parent link="right_shoulder_pitch_link"/>
      <child link="right_shoulder_roll_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.40" upper="1.40" effort="10" velocity="2.0"/>
    </joint>

    <link name="right_shoulder_yaw_link">
      <visual>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>
        <geometry><cylinder radius="0.04" length="0.12"/></geometry>
        <material name="arm_white"/>
      </visual>
      <inertial>
        <mass value="0.4"/>
        <origin xyz="0 0 -0.06"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>
    <joint name="right_shoulder_yaw" type="revolute">
      <parent link="right_shoulder_roll_link"/>
      <child link="right_shoulder_yaw_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.40" upper="1.40" effort="10" velocity="2.0"/>
    </joint>

    <link name="right_forearm_link">
      <visual>
        <origin xyz="0 0 -0.11" rpy="0 0 0"/>
        <geometry><cylinder radius="0.035" length="0.22"/></geometry>
        <material name="arm_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.11" rpy="0 0 0"/>
        <geometry><cylinder radius="0.035" length="0.22"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <origin xyz="0 0 -0.11"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="right_elbow_pitch" type="revolute">
      <parent link="right_shoulder_yaw_link"/>
      <child link="right_forearm_link"/>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.17" upper="2.97" effort="10" velocity="2.0"/>
    </joint>

    <link name="right_wrist_pitch_link">
      <visual>
        <origin xyz="0 0 -0.02" rpy="0 0 0"/>
        <geometry><sphere radius="0.03"/></geometry>
        <material name="joint_dark"/>
      </visual>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
    <joint name="right_wrist_pitch" type="revolute">
      <parent link="right_forearm_link"/>
      <child link="right_wrist_pitch_link"/>
      <origin xyz="0 0 -0.22" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.20" upper="1.20" effort="5" velocity="2.5"/>
    </joint>

    <link name="right_hand_link">
      <visual>
        <origin xyz="0 0 -0.04" rpy="0 0 0"/>
        <geometry><box size="0.05 0.07 0.08"/></geometry>
        <material name="arm_white"/>
      </visual>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 -0.04"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
    <joint name="right_wrist_yaw" type="revolute">
      <parent link="right_wrist_pitch_link"/>
      <child link="right_hand_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.20" upper="1.20" effort="5" velocity="2.5"/>
    </joint>
  </xacro:macro>
</robot>
